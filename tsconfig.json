{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"@rally/telemetry": ["./packages/telemetry/src/index.ts"],
			"@rally/telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"@rally/telemetry/render": ["./packages/telemetry/src/render.ts"],
			"@rally/codemode": ["./packages/codemode/src/index.ts"],
			"@rally/codemode/cloudflare": ["./packages/codemode/src/cloudflare.ts"],
			"@rally/codemode/declarations": ["./packages/codemode/src/declarations.ts"],
			"@rally/codemode/portable": ["./packages/codemode/src/portable.ts"],
			"@rally/codemode/source": ["./packages/codemode/src/source.ts"],
			"@rally/codemode/worker": ["./packages/codemode/src/runtime/worker.ts"],
			"@rally/schema": ["./packages/schema/src/index.ts"],
			"@rally/schema/formats": ["./packages/schema/src/formats/index.ts"],
			"@rally/mcp": ["./packages/mcp/src/index.ts"],
			"@rally/mcp/oauth": ["./packages/mcp/src/oauth/index.ts"],
			"@rally/mcp/testing": ["./packages/mcp/src/testing/index.ts"],
			"@rally/ai": ["./packages/ai/src/index.ts"],
			"@rally/ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@rally/ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@rally/ai/dist/*": ["./packages/ai/src/*"],
			"@rally/agent-core": ["./packages/agent/src/index.ts"],
			"@rally/coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@rally/coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@rally/coding-agent/*": ["./packages/coding-agent/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@rally/tui": ["./packages/tui/src/index.ts"],
			"@rally/tui/*": ["./packages/tui/src/*"]
		}
	},
	"include": ["packages/*/src/**/*", "packages/*/test/**/*", "packages/ai/catalog/**/*"],
	"exclude": [
		"**/dist/**",
		"packages/schema/test/bench/**",
		"packages/coding-agent/test/changelog.test.ts",
		"packages/coding-agent/test/compaction-extensions-example.test.ts",
		"packages/coding-agent/test/extensions-discovery.test.ts",
		"packages/coding-agent/test/git-merge-and-resolve-extension.test.ts",
		"packages/coding-agent/test/input-transform-streaming-example.test.ts",
		"packages/coding-agent/test/jev-router-example.test.ts",
		"packages/coding-agent/test/model-catalog-protocol.test.ts",
		"packages/coding-agent/test/plan-mode-extension.test.ts",
		"packages/coding-agent/test/plan-mode-utils.test.ts",
		"packages/coding-agent/test/subagent-extension.test.ts",
		"packages/coding-agent/test/suite/agent-session-mcp.test.ts",
		"packages/coding-agent/test/suite/regressions/8261-subagent-project-trust.test.ts",
		"packages/coding-agent/test/system-prompt.test.ts",
		"packages/coding-agent/test/tool-renderer-examples.test.ts",
		"packages/coding-agent/test/trigger-compact-extension.test.ts"
	]
}
