[Unit]
Description=Rally personal agent runtime
After=network-online.target
[Service]
User=rally-runtime
Group=rally-runtime
StateDirectory=rally
StateDirectoryMode=0700
RuntimeDirectory=rally-runtime
RuntimeDirectoryMode=0750
Environment=HOME=/var/lib/rally
Environment=PATH=/opt/rally/current/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/var/lib/rally
ExecStart=/opt/rally/current/bin/node /opt/rally/current/src/main/cloud/runtime.ts
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
[Install]
WantedBy=multi-user.target
