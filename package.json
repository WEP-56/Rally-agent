{
	"name": "rally",
	"productName": "Rally",
	"version": "0.3.0",
	"license": "MIT",
	"private": true,
	"type": "module",
	"main": "./out/main/index.js",
	"workspaces": [
		"packages/*"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"dev": "npm run icons && electron-vite dev",
		"build:packages": "npm run build -w @rally/telemetry && npm run build -w @rally/schema && npm run build -w @rally/tui && npm run build -w @rally/codemode && npm run build -w @rally/mcp && npm run build:offline -w @rally/ai && npm run build -w @rally/agent-core && npm run build:unbundled -w @rally/coding-agent",
		"build": "npm run icons && npm run build:packages && electron-vite build",
		"preview": "electron-vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
		"hydrate:model-data": "npm --prefix packages/ai run hydrate-model-data",
		"dist": "npm run build && node scripts/install-agent-browser.mjs && electron-builder --win",
		"icons": "node scripts/generate-icons.mjs",
		"build:server": "npm run build:packages && node scripts/cloud/build-server.mjs",
		"dist:android": "npm run build && node scripts/cloud/build-android.mjs"
	},
	"dependencies": {
		"@larksuiteoapi/lark-mcp": "0.5.1",
		"@larksuiteoapi/node-sdk": "1.76.0",
		"@modelcontextprotocol/sdk": "1.32.2",
		"@mozilla/readability": "0.6.0",
		"@rally/agent-core": "1.5.0",
		"@rally/ai": "1.5.0",
		"@rally/coding-agent": "1.5.0",
		"@rally/mcp": "1.5.0",
		"@tencent-connect/qqbot-nodejs": "1.0.5",
		"cross-spawn": "7.0.6",
		"imapflow": "2.12.2",
		"jsdom": "27.4.0",
		"mailparser": "3.15.0",
		"node-pty": "1.1.0",
		"nodemailer": "10.6.1",
		"playwright": "1.65.1",
		"turndown": "7.2.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@tailwindcss/vite": "4.3.5",
		"@types/cross-spawn": "6.0.6",
		"@types/jsdom": "27.0.0",
		"@types/mailparser": "3.9.0",
		"@types/node": "22.19.19",
		"@types/nodemailer": "8.0.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/turndown": "5.0.6",
		"@vitejs/plugin-react": "6.2.1",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/addon-search": "0.16.0",
		"@xterm/addon-unicode11": "0.9.0",
		"@xterm/addon-web-links": "0.12.0",
		"@xterm/xterm": "6.0.0",
		"clsx": "2.1.1",
		"electron": "45.2.3",
		"electron-builder": "26.18.0",
		"electron-vite": "6.0.0",
		"lucide-react": "1.70.0",
		"png-to-ico": "3.0.2",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1",
		"tailwind-merge": "3.7.0",
		"tailwindcss": "4.3.5",
		"typescript": "7.0.2",
		"vite": "8.3.6",
		"vitest": "4.1.12"
	},
	"overrides": {
		"protobufjs": "7.6.6",
		"@larksuiteoapi/lark-mcp": {
			"basic-ftp": "6.2.6"
		}
	}
}
